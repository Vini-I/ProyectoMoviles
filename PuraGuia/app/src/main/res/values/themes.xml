<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.PuraGuia" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/pg_teal</item>
        <item name="colorPrimaryVariant">@color/pg_teal_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/pg_teal</item>
        <item name="colorSecondaryVariant">@color/pg_teal_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/pg_teal</item>
        <item name="android:windowBackground">@color/pg_bg</item>
        <item name="android:textColorPrimary">@color/pg_text</item>
    </style>

    <style name="Theme.PuraGuia.Splash">
        <item name="android:windowBackground">@drawable/bg_splash</item>
    </style>

    <!-- Textos -->
    <style name="PG.Label" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/pg_text</item>
    </style>

    <style name="PG.SectionTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/pg_teal_dark</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="PG.CardTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/pg_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Campos de texto -->
    <style name="PG.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/pg_text</item>
        <item name="android:textColorHint">@color/pg_text_hint</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="PG.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <!-- Botones (se usan con AppCompatButton) -->
    <style name="PG.Button" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="PG.Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="PG.Button.Blue">
        <item name="android:background">@drawable/bg_button_blue</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="PG.Button.OutlineBlue">
        <item name="android:background">@drawable/bg_button_outline_blue</item>
        <item name="android:textColor">@color/pg_blue</item>
    </style>

    <style name="PG.Button.OutlineGray">
        <item name="android:background">@drawable/bg_button_outline_gray</item>
        <item name="android:textColor">@color/pg_text</item>
    </style>

    <style name="PG.Button.Danger">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Tarjetas -->
    <style name="PG.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">3dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

</resources>
