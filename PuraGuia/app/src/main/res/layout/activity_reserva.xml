<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/include_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/PG.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seleccionar día"
                android:textSize="16sp" />

            <GridLayout
                android:id="@+id/grid_dias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                style="@style/PG.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Seleccionar hora"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spinner_hora"
                    style="@style/PG.Spinner"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1.4" />

                <TextView
                    android:id="@+id/btn_am"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="0.8"
                    android:background="@drawable/bg_chip_sky"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="AM"
                    android:textColor="@color/chip_text_sky"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btn_pm"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="0.8"
                    android:background="@drawable/bg_chip_sky"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="PM"
                    android:textColor="@color/chip_text_sky"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                style="@style/PG.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Método de pago"
                android:textSize="16sp" />

            <GridLayout
                android:id="@+id/grid_pago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:id="@+id/layout_detalle_sinpe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_info_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="SINPE Móvil"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/pg_teal" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="Pago con SINPE Móvil"
                        android:textColor="@color/pg_teal_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btn_configurar_sinpe_reserva"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp"
                        android:text="Configurar"
                        android:textColor="@color/pg_blue"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txt_sinpe_destino"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/pg_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txt_sinpe_origen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/pg_text_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/edit_sinpe_comprobante"
                    style="@style/PG.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="N.º de comprobante SINPE (ej. 123456)"
                    android:inputType="number"
                    android:maxLength="12"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_info_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirmar"
                    android:textAppearance="@style/PG.CardTitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Día"
                        android:textColor="@color/pg_text_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/txt_resumen_dia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/pg_text"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hora"
                        android:textColor="@color/pg_text_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/txt_resumen_hora"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/pg_text"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Duración"
                        android:textColor="@color/pg_text_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/txt_resumen_duracion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/pg_text"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Guía"
                        android:textColor="@color/pg_text_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/txt_resumen_guia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/pg_text"
                        android:textSize="15sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#A5F3FC" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Costo total"
                        android:textColor="@color/pg_text"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txt_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/pg_teal"
                        android:textSize="28sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="8dp"
        android:padding="14dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_confirmar_reserva"
            style="@style/PG.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirmar Reserva" />
    </LinearLayout>
</LinearLayout>
