<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="Archivo"
        android:src="@drawable/ic_check_circle"
        app:tint="@color/pg_green" />

    <TextView
        android:id="@+id/txt_nombre_archivo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="@color/pg_text"
        android:textSize="14sp" />

    <ImageButton
        android:id="@+id/btn_quitar_archivo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Quitar archivo"
        android:src="@drawable/ic_close"
        app:tint="@color/pg_text_muted" />
</LinearLayout>
